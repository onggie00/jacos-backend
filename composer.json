{
	"description": "The CodeIgniter framework",
	"name": "codeigniter/framework",
	"type": "project",
	"homepage": "https://codeigniter.com",
	"license": "MIT",
	"support": {
		"forum": "http://forum.codeigniter.com/",
		"wiki": "https://github.com/bcit-ci/CodeIgniter/wiki",
		"irc": "irc://irc.freenode.net/codeigniter",
		"source": "https://github.com/bcit-ci/CodeIgniter"
	},
	"require": {
		"php": ">=5.2.4",
		"tan5en5/codeigniter-debugbar": "dev-master",
		"compwright/codeigniter-installers": "*",
        "maximebf/debugbar": ">=1.0.0",
		"filp/whoops": "^2.1",
		"nasution/terbilang": "^0.1.0",
		"ktamas77/firebase-php": "^3.0",
		"google/apiclient": "2.14.0",
		"google/auth": "1.37.0",
		"psr/cache": "v1.0.1",
		"simplesoftwareio/simple-qrcode": "^4.2",
		"kreait/firebase-php": "6.0",
		"phpoffice/phpspreadsheet": "^5.8"
	},
	"suggest": {
		"paragonie/random_compat": "Provides better randomness in PHP 5.x"
	},
	"require-dev": {
		"mikey179/vfsstream": "1.1.*"
	},
	"config": {
		"allow-plugins": {
			"compwright/codeigniter-installers": true
		},
		"platform-check": false
	}
}
